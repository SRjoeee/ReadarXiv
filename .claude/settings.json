{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/merge-gate.mjs"],
            "timeout": 30,
            "statusMessage": "Merge gate"
          }
        ]
      }
    ]
  }
}
