{
  "manifest_version": 3,
  "name": "Reader PoC (research)",
  "version": "0.0.1",
  "description": "Research prototype for issue #290: original and translated PDF side by side, linked paragraph by paragraph.",
  "action": {
    "default_title": "Open the reader prototype"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "host_permissions": [
    "https://edge.microsoft.com/*",
    "https://arxiv.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}