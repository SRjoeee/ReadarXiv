{"schema":1,"paper":{"id":"2600.00001","version":1,"pages":4},"base":{"bytes":212737,"sha256":"2ab502e4ffaedec382e025b64c23b7938fb11e8915e347c979efd4c3a029eb69","url":"/api/v1/original/2600.00001v1"},"versions":{"bundle":"2","pipeline":"10","layout":"4","removal":"5","pdfjs":"6.3.289","image":"1"},"units":[["heading",1,null,null,null,[[0,"Counting Lattice Paths Around Blocked Cells"]]],["author",0,null,null,null,[[0,"The Read arXiv Contributors"]]],["para",2,null,null,null,[[0,"October 2026"]]],["abstract",0,null,null,null,[[0,"\nWe count the monotone paths that cross a rectangular grid when some of its cells are blocked. For a grid with "],[1,"$m$"],[0," columns and "],[1,"$n$"],[0," rows and no blocked cell the answer is the binomial coefficient "],[1,"$\\binom{m+n}{n}$"],[0,". With blocked cells, an inclusion--exclusion argument gives an exact formula whose number of terms grows with the number of blocked cells, and a simple dynamic program computes the same number in time proportional to the area of the grid. We compare the two methods on small grids and show that they agree.\n"]]],["heading",0,1,null,null,[[0,"Introduction"]]],["para",0,null,null,null,[[0,"A "],[2,1,"\\emph{"],[0,"monotone path"],[3,1,"}"],[0," on a grid starts at the lower left corner, ends at the upper right corner, and moves only one step to the right or one step up. Such paths are among the first objects a student of combinatorics meets, and their number is classical "],[1,"\\cite{feller,stanley}"],[0,". In this note we ask what happens to the count when an adversary blocks some of the cells, so that a path may not step on them."]]],["footnote",0,null,null,null,[[0,"We use this picture only for motivation; nothing in the rest of the text depends on it."]]],["para",0,null,null,null,[[0,"The question has a practical side. A robot that moves on a warehouse floor may only turn left or right at fixed aisles, and some aisles are closed for repairs. The number of routes it can still take is a rough measure of how much freedom the planner has left."],[4,"\\footnote{",6,"}"]]],["para",0,null,null,null,[[0,"Our contributions are small but complete. We give an exact formula for the number of paths around a set of blocked cells (Theorem"],[1,"~"],[1,"\\ref{thm:count}"],[0,"), we describe a dynamic program that agrees with the formula (Section"],[1,"~"],[1,"\\ref{sec:dp}"],[0,"), and we tabulate both on a few grids (Table"],[1,"~"],[1,"\\ref{tab:counts}"],[0,"). Everything in this note can be checked by hand."]]],["heading",0,1,null,null,[[0,"Setting and notation"]]],["para",0,null,null,null,[[0,"Fix two positive integers "],[1,"$m$"],[0," and "],[1,"$n$"],[0,". We write a point of the grid as a pair "],[1,"$(x,y)$"],[0," with "],[1,"$0 \\le x \\le m$"],[0," and "],[1,"$0 \\le y \\le n$"],[0,". A step moves from "],[1,"$(x,y)$"],[0," to "],[1,"$(x+1,y)$"],[0," or to "],[1,"$(x,y+1)$"],[0,"."]]],["theorem",0,null,null,null,[[0,"\nA "],[2,2,"\\emph{"],[0,"blocked set"],[3,2,"}"],[0," is a finite set "],[1,"$B$"],[0," of points of the grid that contains neither "],[1,"$(0,0)$"],[0," nor "],[1,"$(m,n)$"],[0,". A path is "],[2,3,"\\emph{"],[0,"admissible"],[3,3,"}"],[0," for "],[1,"$B$"],[0," if none of its points lies in "],[1,"$B$"],[0,". We write "],[1,"$\\paths(B)$"],[0," for the number of admissible paths from "],[1,"$(0,0)$"],[0," to "],[1,"$(m,n)$"],[0,".\n"]]],["para",0,null,null,{"inner":"equationpmnnmnmneqfreeequation begin mathcal emptyset binom frac label end"},[[0,"When "],[1,"$B$"],[0," is empty, a path consists of "],[1,"$m$"],[0," steps to the right and "],[1,"$n$"],[0," steps up in some order, so that\n"],[1,"\\begin{equation}\n  \\paths(\\emptyset) = \\binom{m+n}{n} = \\frac{(m+n)!}{m!\\,n!}.\n  \\label{eq:free}\n\\end{equation}"],[0,"\nMore generally, the number of paths from a point "],[1,"$(a,b)$"],[0," to a point "],[1,"$(c,d)$"],[0," with "],[1,"$a \\le c$"],[0," and "],[1,"$b \\le d$"],[0," is "],[1,"$\\binom{(c-a)+(d-b)}{c-a}$"],[0,", and it is zero otherwise. We abbreviate this number by "],[1,"$N\\big((a,b),(c,d)\\big)$"],[0,"."]]],["heading",0,1,null,null,[[0,"An exact formula"]]],["para",0,null,null,null,[[0,"Order the blocked points by their coordinates, first by "],[1,"$x$"],[0," and then by "],[1,"$y$"],[0,", and call them "],[1,"$b_1, b_2, \\dots, b_k$"],[0,". Let "],[1,"$f(i)$"],[0," be the number of paths from "],[1,"$(0,0)$"],[0," to "],[1,"$b_i$"],[0," that avoid every earlier blocked point "],[1,"$b_j$"],[0," with "],[1,"$j < i$"],[0,"."]]],["theorem",0,null,null,{"trail":"finbijifjnbjbi big sum"},[[1,"\\label{lem:first}"],[0,"\nFor every "],[1,"$i$"],[0," with "],[1,"$1 \\le i \\le k$"],[0," we have\n"],[1,"\\[\n  f(i) = N\\big((0,0),b_i\\big) - \\sum_{j<i} f(j)\\, N(b_j,b_i).\n\\]"],[0,"\n"]]],["theorem",0,null,null,null,[[0,"\nEvery path from "],[1,"$(0,0)$"],[0," to "],[1,"$b_i$"],[0," either avoids all earlier blocked points, or it meets a first one, say "],[1,"$b_j$"],[0,". The paths of the second kind with first blocked point "],[1,"$b_j$"],[0," are counted by "],[1,"$f(j)\\,N(b_j,b_i)$"],[0,": an admissible prefix up to "],[1,"$b_j$"],[0," followed by an arbitrary suffix. These cases are disjoint, which proves the claim.\n"]]],["para",0,null,null,null,[[0,"The same argument, applied to the end point, gives the main result of this note."]]],["theorem",0,null,null,{"trail":"equationpbnmnikfinbimneqmainequation begin mathcal big sum label end"},[[1,"\\label{thm:count}"],[0,"\nLet "],[1,"$B = \\{b_1,\\dots,b_k\\}$"],[0," be a blocked set, ordered as above. Then\n"],[1,"\\begin{equation}\n  \\paths(B) = N\\big((0,0),(m,n)\\big) - \\sum_{i=1}^{k} f(i)\\, N\\big(b_i,(m,n)\\big).\n  \\label{eq:main}\n\\end{equation}"],[0,"\n"]]],["theorem",0,null,null,null,[[0,"\nSplit the paths from "],[1,"$(0,0)$"],[0," to "],[1,"$(m,n)$"],[0," according to the first blocked point they meet, if any. Those that meet none are admissible. Those whose first blocked point is "],[1,"$b_i$"],[0," are counted by "],[1,"$f(i)\\,N\\big(b_i,(m,n)\\big)$"],[0,", by the argument of Lemma"],[1,"~"],[1,"\\ref{lem:first}"],[0,". Subtracting all of them from the total gives "],[1,"\\eqref{eq:main}"],[0,".\n"]]],["para",0,null,null,null,[[0,"Formula "],[1,"\\eqref{eq:main}"],[0," needs "],[1,"$k$"],[0," values "],[1,"$f(i)$"],[0,", and each of them needs all the earlier ones, so the work grows like "],[1,"$k^2$"],[0," binomial coefficients. For a handful of blocked cells this is much cheaper than listing paths, but for a dense blocked set it is worse than the method of the next section."]]],["heading",0,1,null,null,[[0,"A dynamic program"]]],["para",0,null,null,{"inner":"gxycasesifxybgxygxyotherwisecases begin text in end"},[[0,"Let "],[1,"$g(x,y)$"],[0," be the number of admissible paths from "],[1,"$(0,0)$"],[0," to the point "],[1,"$(x,y)$"],[0,". Then "],[1,"$g(0,0)=1$"],[0,", and for every other point\n"],[1,"\\[\n  g(x,y) =\n  \\begin{cases}\n    0 & \\text{if } (x,y)\\in B,\\\\\n    g(x-1,y) + g(x,y-1) & \\text{otherwise,}\n  \\end{cases}\n\\]"],[0,"\nwhere a value with a negative coordinate is read as zero. Filling the table row by row takes a constant number of operations per point, hence time proportional to "],[1,"$(m+1)(n+1)$"],[0,", and the answer is "],[1,"$g(m,n)$"],[0,". Figure"],[1,"~"],[1,"\\ref{fig:grid}"],[0," shows a small grid with three blocked cells and one admissible path."]]],["figure",0,null,null,null,[[0,"start"]]],["figure",0,null,null,null,[[0,"goal"]]],["caption",0,null,null,null,[[0,"A grid with "],[1,"$m=5$"],[0," columns and "],[1,"$n=4$"],[0," rows. The three red points are blocked; the blue line is one of the admissible paths."]]],["para",0,null,null,null,[[0,"The two methods answer the same question, so they must agree, and it is a useful habit to check this on small cases. We did so for every blocked set of at most three points on grids with up to six columns and rows, and found no difference."]]],["heading",0,1,null,null,[[0,"Results on small grids"]]],["para",0,null,null,null,[[0,"Table"],[1,"~"],[1,"\\ref{tab:counts}"],[0," lists the number of admissible paths for a few grids. The first column of numbers counts the paths with no blocked cell, as in "],[1,"\\eqref{eq:free}"],[0,". The next two columns block one cell, the point "],[1,"$(\\lfloor m/2\\rfloor,\\lfloor n/2\\rfloor)$"],[0,", and three cells, that point together with "],[1,"$(\\lfloor m/2\\rfloor+1,\\lfloor n/2\\rfloor+1)$"],[0," and "],[1,"$(\\lfloor m/2\\rfloor-1,\\lfloor n/2\\rfloor+1)$"],[0,"; for the grid of Figure"],[1,"~"],[1,"\\ref{fig:grid}"],[0," these are the three red points."]]],["caption",0,null,null,null,[[0,"Admissible paths on small grids."]]],["cell",0,null,{"table":1,"row":0,"col":0,"span":1,"head":true},null,[[1,"\\toprule"],[0,"\nGrid ("],[1,"$m \\times n$"],[0,") "]]],["cell",0,null,{"table":1,"row":0,"col":1,"span":1,"head":true},null,[[0," No blocked cell "]]],["cell",0,null,{"table":1,"row":0,"col":2,"span":1,"head":true},null,[[0," One blocked cell "]]],["cell",0,null,{"table":1,"row":0,"col":3,"span":1,"head":true},null,[[0," Three blocked cells "]]],["para",0,null,null,null,[[0,"Two remarks on the numbers. First, blocking a single cell in the middle of the grid removes roughly half of the paths, since the middle is where most paths cross. Second, three blocked cells leave only a few paths on the smallest grids, but on the "],[1,"$6 \\times 4$"],[0," grid they still leave about a fifth of them."]]],["heading",0,2,null,null,[[0,"Cost of the two methods"]]],["para",0,null,null,null,[[0,"The formula costs about "],[1,"$k^2$"],[0," binomial coefficients and the program costs about "],[1,"$mn$"],[0," additions. With "],[1,"$k=3$"],[0," both methods are instant on every grid of Table"],[1,"~"],[1,"\\ref{tab:counts}"],[0,"; the difference shows only when the grid or the blocked set grows, and with a blocked set that fills a tenth of a large grid the program wins by a wide margin. In practice one would choose the program unless the blocked set is tiny and the grid enormous."]]],["heading",0,1,null,null,[[0,"Possible extensions"]]],["para",0,null,null,null,[[0,"Three variations are natural, and each can be handled by a small change to the program of Section"],[1,"~"],[1,"\\ref{sec:dp}"],[0,".\n"]]],["para",0,null,null,null,[[2,4,"\\emph{"],[0,"Weighted cells."],[3,4,"}"],[0," Give every free point "],[1,"$(x,y)$"],[0," a weight "],[1,"$w(x,y)$"],[0," and let a path count with the product of the weights of the points it visits. The recurrence stays the same with "],[1,"$g(x-1,y)+g(x,y-1)$"],[0," multiplied by "],[1,"$w(x,y)$"],[0,".\n  "]]],["para",0,null,null,null,[[2,5,"\\emph{"],[0,"Diagonal steps."],[3,5,"}"],[0," Allow a step from "],[1,"$(x,y)$"],[0," to "],[1,"$(x+1,y+1)$"],[0," as well. The recurrence gains a third term "],[1,"$g(x-1,y-1)$"],[0,", and the numbers become the Delannoy numbers when no cell is blocked.\n  "]]],["para",0,null,null,null,[[2,6,"\\emph{"],[0,"Several goals."],[3,6,"}"],[0," Ask for the number of admissible paths to every point on the right edge of the grid. The table "],[1,"$g$"],[0," already holds all of them, so the answer costs nothing extra.\n"]]],["para",0,null,null,{"inner":"alignwbpwpeqweightgmnalign begin sum pi prod in label nonumber end"},[[0,"\nFor the first variation the total weight of all paths is\n"],[1,"\\begin{align}\n  W(B) &= \\sum_{\\pi} \\prod_{p\\in\\pi} w(p) \\label{eq:weight}\\\\\n       &= g(m,n), \\nonumber\n\\end{align}"],[0,"\nwhere the sum runs over all admissible paths "],[1,"$\\pi$"],[0,". The formula of Theorem"],[1,"~"],[1,"\\ref{thm:count}"],[0," has a weighted version too, but its terms are no longer binomial coefficients, and we do not pursue it here."]]],["heading",0,1,null,null,[[0,"Conclusion"]]],["para",0,null,null,null,[[0,"We counted monotone lattice paths around blocked cells in two ways and found that they agree. The first way is a closed formula that is pleasant for a handful of blocked cells; the second is a short program that does not care how many cells are blocked. Further reading on related counting problems can be found in the references "],[1,"\\cite{knuth,stanley}"],[0,", and the sources of this note, which are free of copyright, are described at "],[2,7,"\\href{https://example.invalid/sample-1}{"],[0,"the address of the sample"],[3,7,"}"],[0,"."]]]],"left":{"kinds":["heading","author","para","abstract","heading","para","footnote","para","para","heading","para","theorem","para","heading","para","theorem","theorem","para","theorem","theorem","para","heading","para","figure","figure","caption","para","heading","para","caption","cell","cell","cell","cell","para","heading","para","heading","para","para","para","para","para","heading","para"],"pages":[[0,0,612,792],[0,0,612,792],[0,0,612,792],[0,0,612,792]],"units":[[0,0,[[1,147.52,661.95,464.47,677.25]]],[1,6,[[1,229.96,632.67,382.04,643.29]]],[2,10,[[1,271.7,608.22,340.3,618.83]]],[3,13,[[1,114.22,554.74,508.44,563.58],[1,99.27,542.78,512.73,551.63],[1,103.84,535.83,121.95,542.02],[1,110.43,527.97,508.29,534.16],[1,99.27,518.87,512.73,527.72],[1,99.27,506.91,512.72,515.76],[1,99.27,494.96,258.89,503.81]]],[4,107,[[1,96.21,460.1,185.03,472.84]]],[5,108,[[1,72,436.41,540,446.1],[1,72,422.86,540,432.55],[1,72,409.31,540,419],[1,72,395.76,507.53,405.45]]],[6,465,[[1,88.59,70.26,429.98,78.22]]],[7,184,[[1,88.94,382.21,540,391.9],[1,72,368.67,540,378.35],[1,72,355.12,362.53,364.8]]],[8,235,[[1,88.94,341.57,540,351.25],[1,72,328.02,540,337.71],[1,72,314.47,539.99,324.16],[1,72,300.92,148.7,310.61]]],[9,291,[[1,96.21,266.24,242.1,278.98]]],[10,294,[[1,72,242.56,540,252.24],[1,72,229.01,395.48,238.69]]],[11,338,[[1,145.77,208.4,540,218.09],[1,76.24,194.85,540,205.15],[1,72,181.3,246.82,190.99]]],[12,389,[[1,88.94,160.7,540,170.39],[1,234.28,133.1,241.87,143.4],[1,279.28,140.48,308.74,150.17],[1,290.74,125.62,297.29,135.3],[1,336.76,140.48,366.21,150.17],[1,341,125.62,361.98,135.3],[1,530.7,133.1,535.35,142.79],[1,72,104.89,539.